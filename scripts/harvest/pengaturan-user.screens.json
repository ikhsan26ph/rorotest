    {
      "id": "petugasscan-detail",
      "scr": "SCR-11",
      "name": "Detail Petugas Scan",
      "urlFrom": {
        "screen": "petugasscan-list",
        "clsMatch": "viewPetugas",
        "template": "/partner/petugasview/{b64value}"
