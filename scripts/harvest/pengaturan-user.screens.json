    {
      "id": "petugasscan-edit",
      "scr": "SCR-11",
      "name": "Edit Petugas Scan",
      "urlFrom": {
        "screen": "petugasscan-list",
        "clsMatch": "btn-edit",
        "template": "/partner/petugasScanEdit/{b64value}"
