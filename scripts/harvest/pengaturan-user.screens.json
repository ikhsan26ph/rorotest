      "name": "Tambah Sub User",
      "url": "/partner/buatsubuser"
    },
    {
      "id": "subuser-detail",
      "scr": "SCR-07",
      "name": "Detail Sub User",
      "urlFrom": {
        "screen": "subuser-list",
        "hrefMatch": "/partner/detailsubuser/"
      }
    },
    {
      "id": "subuser-edit",
