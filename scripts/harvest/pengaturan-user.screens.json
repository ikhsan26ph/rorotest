{
  "portal": "/partner",
  "loginPath": "/partner",
  "screens": [
    {
      "id": "hakakses-list",
      "scr": "SCR-01",
      "name": "Daftar Hak Akses",
      "url": "/partner/hakAkses"
    },
    {
      "id": "hakakses-list-filter",
      "scr": "SCR-01",
      "name": "Daftar Hak Akses — panel filter terbuka",
      "url": "/partner/hakAkses",
      "steps": [
        {
          "click": ":is(button,a):has-text('Filter')",
          "wait": 800
        }
      ]
    },
    {
      "id": "hakakses-create",
      "scr": "SCR-02",
      "name": "Tambah Hak Akses",
      "url": "/partner/buathakakses"
    },
    {
      "id": "hakakses-detail",
      "scr": "SCR-03",
      "name": "Detail Hak Akses",
      "urlFrom": {
        "screen": "hakakses-list",
        "hrefMatch": "/partner/detailhakakses/"
      }
    },
    {
      "id": "hakakses-edit",
      "scr": "SCR-04",
      "name": "Edit Hak Akses",
      "urlFrom": {
        "screen": "hakakses-list",
        "hrefMatch": "/partner/edithakakses/"
      }
    },
    {
      "id": "subuser-list",
      "scr": "SCR-05",
      "name": "Daftar Sub User",
      "url": "/partner/subUser"
    },
    {
      "id": "subuser-list-filter",
      "scr": "SCR-05",
      "name": "Daftar Sub User — panel filter terbuka",
      "url": "/partner/subUser",
      "steps": [
        {
          "click": ":is(button,a):has-text('Filter')",
          "wait": 800
        }
      ]
